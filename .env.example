# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/research_outreach

# Comma-separated list of origins allowed to call the API (your Lovable app URL, local dev).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Regex matched against the Origin header in addition to CORS_ORIGINS.
CORS_ORIGIN_REGEX=https://.*\.lovable\.app|https://.*\.lovableproject\.com

EMBED_MODEL=all-MiniLM-L6-v2

# Optional: enables the LLM resume-parse fallback and the "llm" email generator.
# LLM_PROVIDER picks which key/model is used: anthropic | groq
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Only needed for pipelines/fetch_papers.py
SEMANTIC_SCHOLAR_API_KEY=
